# Copia este archivo como .env para probar el asistente con IA en local.
# En Vercel estas variables se cargan en Settings > Environment Variables.
# Si no defines AI_API_KEY, el chatbot funciona igual con el motor local.

# gemini | openai | groq | abacus
AI_PROVIDER=gemini

# Clave del proveedor elegido (no la subas al repositorio)
AI_API_KEY=

# Opcional: sobrescribe el modelo por defecto del proveedor
# AI_MODEL=gemini-2.0-flash
